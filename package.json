{
  "name": "alexandru-jungean-website",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "test:security": "node --experimental-vm-modules --test tests/security-contact.test.mjs tests/security-consent.test.mjs tests/security-build.test.mjs",
    "test:security:browser": "npm run build && node tests/security-browser.mjs",
    "dev": "npx --yes serve -l 8888 .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:accessibility": "playwright test --grep @accessibility",
    "test:lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "serve": "^14.2.6"
  }
}
